# Copia este archivo como .env y llena los valores.
# (En Vercel no se usa este archivo: las variables se ponen en el panel del proyecto.)

# ID de cliente OAuth de Google (tipo "Aplicación web").
# Se crea en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Base de datos Turso (obligatoria en Vercel; opcional en tu computadora).
# Si las dejas vacías, se usa un archivo local en ./data/intercambio.db
# TURSO_DATABASE_URL=libsql://intercambio-tuusuario.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Puerto del servidor local
PORT=3000

# Solo para probar en tu computadora: permite entrar con cualquier correo sin Google.
# Así puedes simular a varias personas. En Vercel o con NODE_ENV=production se ignora.
# DEV_LOGIN=true

# --- Solo si lo hospedas en un servidor propio (no Vercel) ---
# NODE_ENV=production
# TRUST_PROXY=1
# DATA_DIR=/var/data
